# Copy to .env and adjust. Docker Compose loads .env from this directory automatically.
# Do not commit .env (it is gitignored).

# --- VMware ESXi (required for VM operations) ---
ESXI_HOST=your.esxi.host.ip
ESXI_USER=root
ESXI_PASSWORD=your_esxi_password

# --- Web UI API URL (browser must reach this; baked into Next at build time in Docker) ---
# Local dev: npm run dev with export NEXT_PUBLIC_API_URL=...
# Docker default: http://127.0.0.1:8000 (host maps port 8000 to the API container)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# --- Backend auth & database ---
# Strong random string in production (JWT signing)
JWT_SECRET=change-me-use-long-random-secret

# Optional: token lifetime in minutes (default 1440 = 24h)
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite URL. Docker Compose sets sqlite:////app/data/app.db inside the container.
# Local backend: default is sqlite:///./data/app.db under backend/
# DATABASE_URL=sqlite:///./data/app.db

# Comma-separated browser origins allowed for CORS (no spaces after commas)
CORS_ORIGINS=http://localhost:5656,http://127.0.0.1:5656,http://localhost:3000,http://127.0.0.1:3000

# First admin user created automatically only when the users table is empty
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=changeme
